#!/usr/bin/env python3
"""Ask Kody's twin to pick one option. stdin: {"question", "options":[labels], "context"}.
stdout: {"pick": label, "confidence": 0..1} or {"error": "..."}. Never asks anyone else.
Hosts come from ~/.claude/away.json (helper_host + standby_hosts); OPENRAPPTER_TWIN_CMD overrides (tests)."""
import json, os, re, shlex, subprocess, sys

def main():
    req = json.load(sys.stdin)
    q, opts = req["question"], req["options"]
    prompt = (q + "\nPick exactly one of: " + " | ".join(opts) +
              "\nEnd with two lines: PICK: <option> and CONFIDENCE: <0-100>")
    override = os.environ.get("OPENRAPPTER_TWIN_CMD")
    if override:
        r = subprocess.run(override, shell=True, input=prompt, capture_output=True, text=True, timeout=90)
        out = r.stdout
    else:
        try:
            cfg = json.load(open(os.path.expanduser("~/.claude/away.json")))
        except Exception:
            cfg = {}
        hosts = [h for h in [cfg.get("helper_host", "")] + list(cfg.get("standby_hosts", [])) if h]
        if not hosts:
            return {"error": "no twin machine set up"}
        out = ""
        cmd = 'ctx=$(cat); ~/kody-twin/decide.sh --dry-run --context "$ctx" ' + shlex.quote(prompt)
        for h in hosts:
            try:
                r = subprocess.run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=4", h, cmd],
                                   input=req.get("context", ""), capture_output=True, text=True, timeout=90)
            except subprocess.TimeoutExpired:
                continue
            if r.returncode != 255:
                out = r.stdout
                break
        if not out:
            return {"error": "the twin's machines are not answering"}
    pick = re.findall(r"PICK:\s*(.+)", out)
    conf = re.findall(r"CONFIDENCE:\s*([0-9.]+)", out)
    if not pick or not conf:
        return {"error": "the twin gave no clear pick"}
    label = pick[-1].strip().strip("*`\"' ")
    label = next((o for o in opts if o.lower() == label.lower()), None)
    if not label:
        return {"error": "the twin picked something that was not offered"}
    c = float(conf[-1]); c = c / 100 if c > 1 else c
    return {"pick": label, "confidence": round(c, 2)}

if __name__ == "__main__":
    try:
        print(json.dumps(main()))
    except Exception as e:
        print(json.dumps({"error": str(e)[:200]}))
