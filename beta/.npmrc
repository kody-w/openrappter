# A package postinstall must not fetch and execute a native binary. ffmpeg-static
# downloads an executable from a third-party release with no checksum, no
# signature, and chmods it 0755. Electron's installer is invoked explicitly by
# install.sh, which is the only lifecycle script this app actually needs.
ignore-scripts=true

# The floor in package.json engines was declared and never enforced: npm installs
# happily on an unsupported Node and the failure surfaces much later as a dozen
# unrelated test errors (node:sqlite is absent before 22.5). Refuse at install
# instead, where the message can name the required and actual versions.
engine-strict=true
