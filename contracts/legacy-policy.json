    "LearnNewAgent", "AgentRegistry", "OpenRappterBar", "OPENRAPPTER_HOME",
    "OPENRAPPTER_BRAINSTEM", "brainstem-client", "native-bridge"
  ],
  "forbiddenExtensions": [".py", ".pyc", ".pyo", ".ps1", ".bat", ".exe", ".dll"],
