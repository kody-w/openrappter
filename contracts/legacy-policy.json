{
  "schema": "rapp-work.legacy-policy/1",
  "forbiddenRoots": [
    "typescript", "python", "macos", "ios", "vui", "agents", "tools",
    "openclaw", "openrappter-obsidian", "fable5", "parity_vectors"
  ],
  "forbiddenPathSegments": [
    "openrappter", ".openrappter", "openclaw", "clawhub", "brainstem",
    "channels", "marketplace", "bar", "native-bridge"
  ],
  "forbiddenFiles": [
