{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openrappter.dev/contracts/rappid-card-trust.schema.json",
  "title": "Authenticated RAPPID card trust documents",
  "oneOf": [
    {
      "$ref": "#/$defs/policy"
    },
    {
      "$ref": "#/$defs/authorization"
    },
    {
      "$ref": "#/$defs/revocations"
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,63}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "maxLength": 32
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "minimum",
        "maximum"
      ],
      "properties": {
        "name": {
          "const": "openrappter"
        },
        "minimum": {
          "$ref": "#/$defs/semver"
        },
        "maximum": {
          "$ref": "#/$defs/semver"
        }
      }
    },
    "profile": {
      "enum": [
        "rappid-card-test/1",
        "rappid-card-production/1"
      ]
    },
    "algorithm": {
      "enum": [
        "ed25519-test",
        "ed25519"
      ]
    },
    "classification": {
      "enum": [
        "public",
        "internal",
        "restricted"
      ]
    },
    "scope": {
      "enum": [
        "identity:read",
        "traits:read",
        "skill:hydrate",
        "sonic:hydrate",
        "capability:hydrate"
      ]
    },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/scope"
      }
    },
    "origins": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^https://[a-z0-9.-]+(?::[1-9][0-9]{0,4})?$",
        "maxLength": 200
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "keyId",
        "value"
      ],
      "properties": {
        "algorithm": {
          "$ref": "#/$defs/algorithm"
        },
        "keyId": {
          "$ref": "#/$defs/identifier"
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{86}$"
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "policyId",
        "sequence",
        "issuedAt",
        "expiresAt",
        "allowedProfiles",
        "protocol",
        "runtime",
        "maxClassification",
        "grantedScopes",
        "approvedOrigins",
        "signature"
      ],
      "properties": {
        "schema": {
          "const": "rappid-card-policy/1"
        },
        "policyId": {
          "$ref": "#/$defs/identifier"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "issuedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "expiresAt": {
          "$ref": "#/$defs/timestamp"
        },
        "allowedProfiles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/profile"
          }
        },
        "protocol": {
          "const": "rappid-link/1"
        },
        "runtime": {
          "$ref": "#/$defs/runtime"
        },
        "maxClassification": {
          "$ref": "#/$defs/classification"
        },
        "grantedScopes": {
          "$ref": "#/$defs/scopes"
        },
        "approvedOrigins": {
          "$ref": "#/$defs/origins"
        },
        "signature": {
          "$ref": "#/$defs/signature"
        }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "authorizationId",
        "policyId",
        "sequence",
        "subjectRappid",
        "signerKeyId",
        "signerAlgorithm",
        "signerPublicKey",
        "notBefore",
        "notAfter",
        "maxClassification",
        "grantedScopes",
        "approvedOrigins",
        "signature"
      ],
      "properties": {
        "schema": {
          "const": "rappid-card-authorization/1"
        },
        "authorizationId": {
          "$ref": "#/$defs/identifier"
        },
        "policyId": {
          "$ref": "#/$defs/identifier"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "subjectRappid": {
          "type": "string",
          "pattern": "^rappid:@[a-z0-9](?:[a-z0-9-]{0,38}[a-z0-9])?/[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?:[0-9a-f]{64}$"
        },
        "signerKeyId": {
          "$ref": "#/$defs/identifier"
        },
        "signerAlgorithm": {
          "$ref": "#/$defs/algorithm"
        },
        "signerPublicKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "notBefore": {
          "$ref": "#/$defs/timestamp"
        },
        "notAfter": {
          "$ref": "#/$defs/timestamp"
        },
        "maxClassification": {
          "$ref": "#/$defs/classification"
        },
        "grantedScopes": {
          "$ref": "#/$defs/scopes"
        },
        "approvedOrigins": {
          "$ref": "#/$defs/origins"
        },
        "signature": {
          "$ref": "#/$defs/signature"
        }
      }
    },
    "revocations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "policyId",
        "sequence",
        "issuedAt",
        "expiresAt",
        "revokedManifestHashes",
        "revokedSignerKeyIds",
        "revokedAuthorizationIds",
        "signature"
      ],
      "properties": {
        "schema": {
          "const": "rappid-card-revocations/1"
        },
        "policyId": {
          "$ref": "#/$defs/identifier"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "issuedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "expiresAt": {
          "$ref": "#/$defs/timestamp"
        },
        "revokedManifestHashes": {
          "type": "array",
          "maxItems": 1024,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "revokedSignerKeyIds": {
          "type": "array",
          "maxItems": 1024,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "revokedAuthorizationIds": {
          "type": "array",
          "maxItems": 1024,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "signature": {
          "$ref": "#/$defs/signature"
        }
      }
    }
  }
}
