{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openrappter.dev/contracts/rappid-card.schema.json",
  "title": "RAPP/1 RAPPID Calling Card or Debug Card frame",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec",
    "kind",
    "stream_id",
    "seq",
    "utc",
    "payload",
    "payload_hash",
    "frame_hash",
    "prev",
    "prev_wave",
    "sig"
  ],
  "properties": {
    "spec": { "const": "rapp/1" },
    "kind": { "enum": ["body.calling-card", "body.debug-card"] },
    "stream_id": { "$ref": "#/$defs/rappid" },
    "seq": { "$ref": "#/$defs/uint53" },
    "utc": { "$ref": "#/$defs/utc" },
    "payload": { "$ref": "#/$defs/payload" },
    "payload_hash": { "$ref": "#/$defs/hex64" },
    "frame_hash": { "$ref": "#/$defs/hex64" },
    "prev": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/hex64" }
      ]
    },
    "prev_wave": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/hex64" }
      ]
    },
    "sig": { "$ref": "#/$defs/jws" }
  },
  "$defs": {
    "uint53": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "hex64": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "lclabel": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "versioned": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*/[1-9][0-9]*$"
    },
    "rappid": {
      "type": "string",
      "pattern": "^rappid:@[a-z0-9]+(?:-[a-z0-9]+)*/[a-z0-9]+(?:-[a-z0-9]+)*:[0-9a-f]{64}$"
    },
    "jws": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+\\.\\.[A-Za-z0-9_-]+$"
    },
    "parent": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["rappid", "particle"],
          "properties": {
            "rappid": { "$ref": "#/$defs/rappid" },
            "particle": { "$ref": "#/$defs/hex64" }
          }
        }
      ]
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "runtime", "features"],
      "properties": {
        "protocol": { "$ref": "#/$defs/versioned" },
        "runtime": { "$ref": "#/$defs/versioned" },
        "features": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/versioned" }
        }
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["part", "space", "hash", "bytes", "required"],
      "properties": {
        "part": { "$ref": "#/$defs/lclabel" },
        "space": { "const": "rapp/1:egg" },
        "hash": { "$ref": "#/$defs/hex64" },
        "bytes": { "$ref": "#/$defs/uint53" },
        "required": { "type": "boolean" }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "rappid",
        "soul_hash",
        "parent",
        "engram_root",
        "reflex_capability_root",
        "compatibility",
        "classification",
        "requested_scope",
        "expires_utc",
        "revocation_url",
        "endpoint_origin",
        "wake_challenge",
        "inventory",
        "key_id"
      ],
      "properties": {
        "profile": {
          "enum": ["rappid-card/1", "rappid-card-test/1"]
        },
        "rappid": { "$ref": "#/$defs/rappid" },
        "soul_hash": { "$ref": "#/$defs/hex64" },
        "parent": { "$ref": "#/$defs/parent" },
        "engram_root": { "$ref": "#/$defs/hex64" },
        "reflex_capability_root": { "$ref": "#/$defs/hex64" },
        "compatibility": { "$ref": "#/$defs/compatibility" },
        "classification": {
          "enum": ["public", "internal", "confidential", "restricted"]
        },
        "requested_scope": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/lclabel" }
        },
        "expires_utc": { "$ref": "#/$defs/utc" },
        "revocation_url": { "type": "string" },
        "endpoint_origin": { "type": "string" },
        "wake_challenge": { "$ref": "#/$defs/hex64" },
        "inventory": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/inventory" }
        },
        "key_id": { "$ref": "#/$defs/rappid" }
      }
    }
  }
}
