{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openrappter.dev/contracts/rappid-card.schema.json",
  "title": "OpenRappter virtual RAPPID card",
  "description": "A closed, non-secret, content-addressed handoff manifest. The conventional filename is .rappid-card.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "profile",
    "rappid",
    "endpoint",
    "nonce",
    "issuedAt",
    "expiresAt",
    "protocol",
    "runtime",
    "classification",
    "scopes",
    "parts",
    "challenge",
    "signature"
  ],
  "properties": {
    "schema": {
      "const": "rappid-card/1"
    },
    "profile": {
      "enum": [
        "rappid-card-test/1",
        "rappid-card-production/1"
      ]
    },
    "rappid": {
      "type": "string",
      "pattern": "^rappid:@[a-z0-9](?:[a-z0-9-]{0,38}[a-z0-9])?/[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?:[0-9a-f]{64}$",
      "maxLength": 180
    },
    "endpoint": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{0,63}$"
    },
    "nonce": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time",
      "maxLength": 32
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "maxLength": 32
    },
    "protocol": {
      "type": "string",
      "pattern": "^rappid-link/[1-9][0-9]*$",
      "maxLength": 32
    },
    "runtime": {
      "$ref": "#/$defs/runtime"
    },
    "classification": {
      "$ref": "#/$defs/classification"
    },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/scope"
      }
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/part"
      }
    },
    "challenge": {
      "$ref": "#/$defs/authenticator"
    },
    "signature": {
      "$ref": "#/$defs/signature"
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "maxLength": 32
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "minimum",
        "maximum"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,31}$"
        },
        "minimum": {
          "$ref": "#/$defs/semver"
        },
        "maximum": {
          "$ref": "#/$defs/semver"
        }
      }
    },
    "classification": {
      "enum": [
        "public",
        "internal",
        "restricted"
      ]
    },
    "scope": {
      "enum": [
        "identity:read",
        "traits:read",
        "skill:hydrate",
        "sonic:hydrate",
        "capability:hydrate"
      ]
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "hash",
        "bytes",
        "mediaType",
        "classification",
        "scope",
        "required"
      ],
      "properties": {
        "name": {
          "enum": [
            "identity",
            "traits",
            "skill-manifest",
            "sonic-profile",
            "capability-manifest"
          ]
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "mediaType": {
          "enum": [
            "application/json",
            "text/plain",
            "application/vnd.rapp.skill+json",
            "application/vnd.rapp.sonic+json",
            "application/vnd.rapp.capability+json"
          ]
        },
        "classification": {
          "$ref": "#/$defs/classification"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "authenticator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "keyId"
      ],
      "properties": {
        "algorithm": {
          "enum": [
            "hmac-sha256-test",
            "hmac-sha256"
          ]
        },
        "keyId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{0,63}$"
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "keyId",
        "value"
      ],
      "properties": {
        "algorithm": {
          "enum": [
            "hmac-sha256-test",
            "hmac-sha256"
          ]
        },
        "keyId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{0,63}$"
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
