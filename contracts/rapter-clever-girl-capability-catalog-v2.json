{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openrappter.dev/contracts/rapter-clever-girl-capability-catalog-v2.json",
  "title": "Rapter Clever Girl Behavioral Capability Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "capabilities"],
  "properties": {
    "schema": {
      "const": "rapter-clever-girl.capabilities.v2"
    },
    "capabilities": {
      "type": "array",
      "maxItems": 50000,
      "items": {
        "$ref": "#/$defs/capability"
      }
    }
  },
  "$defs": {
    "boundedString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "description"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "description": {
          "$ref": "#/$defs/boundedString"
        }
      }
    },
    "permission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource", "access", "reason"],
      "properties": {
        "resource": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
        },
        "access": {
          "enum": ["none", "read", "write", "execute"]
        },
        "reason": {
          "$ref": "#/$defs/boundedString"
        }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "condition", "behavior"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        "condition": {
          "$ref": "#/$defs/boundedString"
        },
        "behavior": {
          "$ref": "#/$defs/boundedString"
        }
      }
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "assertion"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$"
        },
        "assertion": {
          "$ref": "#/$defs/boundedString"
        }
      }
    },
    "behavioralContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "version",
        "inputs",
        "outputs",
        "permissions",
        "failures",
        "limitations",
        "tests"
      ],
      "properties": {
        "schemaVersion": {
          "const": "rapter-clever-girl.capability-contract.v1"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/field"
          }
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/field"
          }
        },
        "permissions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/permission"
          }
        },
        "failures": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/failure"
          }
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/boundedString"
          }
        },
        "tests": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/test"
          }
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description",
        "tags",
        "behavioralContract"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        },
        "description": {
          "$ref": "#/$defs/boundedString"
        },
        "tags": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "behavioralContract": {
          "$ref": "#/$defs/behavioralContract"
        }
      }
    }
  }
}
