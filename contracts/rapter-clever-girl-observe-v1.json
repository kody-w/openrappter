{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openrappter.dev/contracts/rapter-clever-girl-observe-v1.json",
  "title": "Rapter Clever Girl Observe Mode Report",
  "description": "Deterministic, local-only observations over explicitly selected coding-assistant history exports.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "mode",
    "status",
    "scope",
    "sources",
    "summary",
    "candidates",
    "excluded",
    "diagnostics"
  ],
  "properties": {
    "schemaVersion": {
      "const": "rapter-clever-girl.observe.v1"
    },
    "mode": {
      "const": "observe"
    },
    "status": {
      "enum": [
        "ok",
        "partial",
        "failed"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "windowStart",
        "windowEnd",
        "minimumSessions",
        "minimumActiveDays",
        "skillsRootsCount"
      ],
      "properties": {
        "windowStart": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "windowEnd": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "minimumSessions": {
          "type": "integer",
          "minimum": 2
        },
        "minimumActiveDays": {
          "type": "integer",
          "minimum": 1
        },
        "skillsRootsCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceId",
          "sourceType",
          "sourceDigest",
          "status",
          "acceptedRecords",
          "skippedRecords"
        ],
        "properties": {
          "sourceId": {
            "type": "string",
            "pattern": "^source-[a-f0-9]{12}$"
          },
          "sourceType": {
            "enum": [
              "auto",
              "claude",
              "codex",
              "copilot",
              "openrappter",
              "normalized"
            ]
          },
          "sourceDigest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "status": {
            "enum": [
              "ok",
              "partial",
              "failed"
            ]
          },
          "acceptedRecords": {
            "type": "integer",
            "minimum": 0
          },
          "skippedRecords": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessions",
        "activeDays",
        "acceptedRecords",
        "skippedRecords",
        "candidateCount",
        "highConfidenceCandidateCount"
      ],
      "properties": {
        "sessions": {
          "type": "integer",
          "minimum": 0
        },
        "activeDays": {
          "type": "integer",
          "minimum": 0
        },
        "acceptedRecords": {
          "type": "integer",
          "minimum": 0
        },
        "skippedRecords": {
          "type": "integer",
          "minimum": 0
        },
        "candidateCount": {
          "type": "integer",
          "minimum": 0
        },
        "highConfidenceCandidateCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "candidates": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidateId",
          "label",
          "patternType",
          "classification",
          "confidence",
          "occurrences",
          "sessions",
          "activeDays",
          "evidence",
          "observedActiveFriction",
          "existingCapability",
          "falsePositiveRisks"
        ],
        "properties": {
          "candidateId": {
            "type": "string",
            "pattern": "^candidate-[a-f0-9]{16}$"
          },
          "label": {
            "enum": [
              "Repeated setup or recovery workflow",
              "Repeated review or release workflow",
              "Repeated traceable delivery workflow",
              "Repeated correction rule",
              "Repeated tool sequence",
              "Recurring workflow"
            ]
          },
          "patternType": {
            "enum": [
              "repair-loop",
              "review-workflow",
              "delivery-workflow",
              "recurring-correction",
              "tool-sequence",
              "generic-workflow"
            ]
          },
          "classification": {
            "enum": [
              "root-cause-fix",
              "reuse-existing",
              "extend-existing",
              "new-skill-candidate",
              "new-automation-candidate",
              "workflow-fix",
              "insufficient-evidence"
            ]
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "occurrences": {
            "type": "integer",
            "minimum": 2
          },
          "sessions": {
            "type": "integer",
            "minimum": 2
          },
          "activeDays": {
            "type": "integer",
            "minimum": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "evidenceId",
                "sourceId",
                "sessionAlias",
                "day",
                "recordOrdinals",
                "ruleId"
              ],
              "properties": {
                "evidenceId": {
                  "type": "string",
                  "pattern": "^evidence-[a-f0-9]{20}$"
                },
                "sourceId": {
                  "type": "string",
                  "pattern": "^source-[a-f0-9]{12}$"
                },
                "sessionAlias": {
                  "type": "string",
                  "pattern": "^session-[0-9]{3}$"
                },
                "day": {
                  "type": "string",
                  "format": "date"
                },
                "recordOrdinals": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "ruleId": {
                  "type": "string",
                  "pattern": "^detector\\.[a-z0-9.-]+\\.v1$"
                }
              }
            }
          },
          "observedActiveFriction": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "lowerSeconds",
              "upperSeconds",
              "method",
              "confidence"
            ],
            "properties": {
              "lowerSeconds": {
                "type": "integer",
                "minimum": 0
              },
              "upperSeconds": {
                "type": "integer",
                "minimum": 0
              },
              "method": {
                "const": "capped-active-intervals-v1"
              },
              "confidence": {
                "enum": [
                  "medium",
                  "low",
                  "unavailable"
                ]
              }
            }
          },
          "existingCapability": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "name",
              "match",
              "reason"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "match": {
                "enum": [
                  "reuse",
                  "extend",
                  "possible-overlap"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "falsePositiveRisks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "excluded": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "controlMessages",
        "belowEvidenceThreshold",
        "intentionalVerificationLoops"
      ],
      "properties": {
        "controlMessages": {
          "type": "integer",
          "minimum": 0
        },
        "belowEvidenceThreshold": {
          "type": "integer",
          "minimum": 0
        },
        "intentionalVerificationLoops": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceId",
          "status",
          "stage",
          "code",
          "acceptedRecords",
          "skippedRecords",
          "message"
        ],
        "properties": {
          "sourceId": {
            "type": "string",
            "pattern": "^source-[a-f0-9]{12}$"
          },
          "status": {
            "enum": [
              "partial",
              "failed"
            ]
          },
          "stage": {
            "enum": [
              "read",
              "parse",
              "normalize",
              "redact",
              "mine"
            ]
          },
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]+$"
          },
          "acceptedRecords": {
            "type": "integer",
            "minimum": 0
          },
          "skippedRecords": {
            "type": "integer",
            "minimum": 0
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "x-openrappter-contract": {
    "detectorVersion": "1",
    "maximumCandidates": 5,
    "minimumSessions": 3,
    "minimumActiveDays": 2,
    "activeGapCapSeconds": 300,
    "supportedInputs": [
      "claude-jsonl",
      "codex-jsonl",
      "copilot-export-jsonl",
      "openrappter-flight-json",
      "normalized-jsonl"
    ],
    "observeInvariants": [
      "explicit input paths only",
      "source files opened read-only",
      "no network calls",
      "no subprocess execution",
      "no repository, history, skill, hook, schedule, or automation mutation",
      "stdout is the only default output",
      "explicit output is POSIX-only, private, no-clobber, and outside selected source and skill scope",
      "raw prompts, tool arguments, outputs, paths, and identifiers never appear in reports",
      "transcript content is inert data",
      "every partial or failed source is reported",
      "promotion is outside this contract"
    ],
    "cli": {
      "command": "node scripts/rapter-clever-girl.mjs observe",
      "required": [
        "--input <path>"
      ],
      "repeatable": [
        "--input <path>",
        "--skills-root <path>"
      ],
      "optional": [
        "--source auto|claude|codex|copilot|openrappter|normalized",
        "--since <ISO-8601>",
        "--until <ISO-8601>",
        "--min-sessions <integer>",
        "--min-days <integer>",
        "--output <new-explicit-POSIX-path>",
        "--pretty"
      ]
    }
  }
}
