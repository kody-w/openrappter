{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openrappter.dev/contracts/rapter-clever-girl-observe-v2.json",
  "title": "Rapter Clever Girl Observe Mode Report",
  "description": "Deterministic, local-only workflow observations with explicit session, repository-activity, estate, and capability-catalog evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "mode",
    "status",
    "scope",
    "sources",
    "summary",
    "candidates",
    "excluded",
    "context",
    "replay",
    "diagnostics"
  ],
  "properties": {
    "schemaVersion": {
      "const": "rapter-clever-girl.observe.v2"
    },
    "mode": {
      "const": "observe"
    },
    "status": {
      "enum": ["ok", "partial", "failed"]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "windowStart",
        "windowEnd",
        "minimumSessions",
        "minimumActiveDays",
        "skillsRootsCount",
        "repositoryActivityInputsCount",
        "capabilityCatalogInputsCount",
        "estateManifestProvided"
      ],
      "properties": {
        "windowStart": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "windowEnd": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "minimumSessions": {
          "type": "integer",
          "minimum": 2
        },
        "minimumActiveDays": {
          "type": "integer",
          "minimum": 1
        },
        "skillsRootsCount": {
          "type": "integer",
          "minimum": 0
        },
        "repositoryActivityInputsCount": {
          "type": "integer",
          "minimum": 0
        },
        "capabilityCatalogInputsCount": {
          "type": "integer",
          "minimum": 0
        },
        "estateManifestProvided": {
          "type": "boolean"
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sessionSource"
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessions",
        "activeDays",
        "acceptedRecords",
        "skippedRecords",
        "candidateCount",
        "highConfidenceCandidateCount",
        "selectedCandidateId",
        "repositoryActivityRecords",
        "capabilitiesInspected"
      ],
      "properties": {
        "sessions": {
          "type": "integer",
          "minimum": 0
        },
        "activeDays": {
          "type": "integer",
          "minimum": 0
        },
        "acceptedRecords": {
          "type": "integer",
          "minimum": 0
        },
        "skippedRecords": {
          "type": "integer",
          "minimum": 0
        },
        "candidateCount": {
          "type": "integer",
          "minimum": 0
        },
        "highConfidenceCandidateCount": {
          "type": "integer",
          "minimum": 0
        },
        "selectedCandidateId": {
          "type": ["string", "null"],
          "pattern": "^candidate-[a-f0-9]{16}$"
        },
        "repositoryActivityRecords": {
          "type": "integer",
          "minimum": 0
        },
        "capabilitiesInspected": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "candidates": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/candidate"
      }
    },
    "excluded": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "controlMessages",
        "belowEvidenceThreshold",
        "intentionalVerificationLoops",
        "candidateCap",
        "evidenceItems",
        "workLimitEvents",
        "duplicateSources",
        "duplicateCatalogs",
        "duplicateActivitySources"
      ],
      "properties": {
        "controlMessages": {
          "type": "integer",
          "minimum": 0
        },
        "belowEvidenceThreshold": {
          "type": "integer",
          "minimum": 0
        },
        "intentionalVerificationLoops": {
          "type": "integer",
          "minimum": 0
        },
        "candidateCap": {
          "type": "integer",
          "minimum": 0
        },
        "evidenceItems": {
          "type": "integer",
          "minimum": 0
        },
        "workLimitEvents": {
          "type": "integer",
          "minimum": 0
        },
        "duplicateSources": {
          "type": "integer",
          "minimum": 0
        },
        "duplicateCatalogs": {
          "type": "integer",
          "minimum": 0
        },
        "duplicateActivitySources": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "estateManifest",
        "capabilityCatalogs",
        "repositoryActivitySources",
        "catalogCoverage"
      ],
      "properties": {
        "estateManifest": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/estateSource"
            }
          ]
        },
        "capabilityCatalogs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/catalogSource"
          }
        },
        "repositoryActivitySources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/activitySource"
          }
        },
        "catalogCoverage": {
          "enum": ["none", "partial", "complete"]
        }
      }
    },
    "replay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["analyzerVersion", "analysisFingerprint"],
      "properties": {
        "analyzerVersion": {
          "const": "2"
        },
        "analysisFingerprint": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    }
  },
  "$defs": {
    "status": {
      "enum": ["ok", "partial", "failed"]
    },
    "sourceBaseProperties": {
      "sourceId": {
        "type": "string",
        "pattern": "^source-[a-f0-9]{12}$"
      },
      "sourceDigest": {
        "type": "string",
        "pattern": "^sha256:[a-f0-9]{64}$"
      },
      "status": {
        "$ref": "#/$defs/status"
      },
      "acceptedRecords": {
        "type": "integer",
        "minimum": 0
      },
      "skippedRecords": {
        "type": "integer",
        "minimum": 0
      }
    },
    "sessionSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "sourceType",
        "sourceDigest",
        "status",
        "acceptedRecords",
        "skippedRecords"
      ],
      "properties": {
        "sourceId": {
          "$ref": "#/$defs/sourceBaseProperties/sourceId"
        },
        "sourceType": {
          "enum": ["auto", "claude", "codex", "copilot", "openrappter", "normalized"]
        },
        "sourceDigest": {
          "$ref": "#/$defs/sourceBaseProperties/sourceDigest"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "acceptedRecords": {
          "$ref": "#/$defs/sourceBaseProperties/acceptedRecords"
        },
        "skippedRecords": {
          "$ref": "#/$defs/sourceBaseProperties/skippedRecords"
        }
      }
    },
    "estateSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "sourceType",
        "sourceDigest",
        "status",
        "schema",
        "snapshotAt",
        "acceptedRecords",
        "skippedRecords",
        "repositoryCount",
        "withheldFiles",
        "skippedLargeFiles"
      ],
      "properties": {
        "sourceId": {
          "$ref": "#/$defs/sourceBaseProperties/sourceId"
        },
        "sourceType": {
          "const": "rapp-monorepo-manifest"
        },
        "sourceDigest": {
          "$ref": "#/$defs/sourceBaseProperties/sourceDigest"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "schema": {
          "type": ["string", "null"]
        },
        "snapshotAt": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "acceptedRecords": {
          "$ref": "#/$defs/sourceBaseProperties/acceptedRecords"
        },
        "skippedRecords": {
          "$ref": "#/$defs/sourceBaseProperties/skippedRecords"
        },
        "repositoryCount": {
          "type": "integer",
          "minimum": 0
        },
        "withheldFiles": {
          "type": "integer",
          "minimum": 0
        },
        "skippedLargeFiles": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "catalogSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "sourceType",
        "sourceDigest",
        "status",
        "schema",
        "acceptedRecords",
        "skippedRecords"
      ],
      "properties": {
        "sourceId": {
          "$ref": "#/$defs/sourceBaseProperties/sourceId"
        },
        "sourceType": {
          "enum": [
            "capability-catalog",
            "rapp-registry",
            "rapp-store",
            "rapp-skills",
            "rar-match",
            "normalized-capabilities"
          ]
        },
        "sourceDigest": {
          "$ref": "#/$defs/sourceBaseProperties/sourceDigest"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "schema": {
          "type": ["string", "null"]
        },
        "acceptedRecords": {
          "$ref": "#/$defs/sourceBaseProperties/acceptedRecords"
        },
        "skippedRecords": {
          "$ref": "#/$defs/sourceBaseProperties/skippedRecords"
        }
      }
    },
    "activitySource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "sourceType",
        "sourceDigest",
        "status",
        "acceptedRecords",
        "skippedRecords"
      ],
      "properties": {
        "sourceId": {
          "$ref": "#/$defs/sourceBaseProperties/sourceId"
        },
        "sourceType": {
          "const": "repository-activity"
        },
        "sourceDigest": {
          "$ref": "#/$defs/sourceBaseProperties/sourceDigest"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "acceptedRecords": {
          "$ref": "#/$defs/sourceBaseProperties/acceptedRecords"
        },
        "skippedRecords": {
          "$ref": "#/$defs/sourceBaseProperties/skippedRecords"
        }
      }
    },
    "capabilityMatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capabilityId", "name", "match", "reason", "sourceTypes"],
      "properties": {
        "capabilityId": {
          "type": "string",
          "pattern": "^capability-[a-f0-9]{16}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "match": {
          "enum": ["reuse", "extend", "possible-overlap"]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "sourceTypes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateId",
        "label",
        "patternType",
        "classification",
        "confidence",
        "occurrences",
        "sessions",
        "activeDays",
        "evidence",
        "observedActiveFriction",
        "existingCapability",
        "capabilityMatches",
        "catalogCoverage",
        "repositoryEvidence",
        "priorityBasisPoints",
        "falsePositiveRisks"
      ],
      "properties": {
        "candidateId": {
          "type": "string",
          "pattern": "^candidate-[a-f0-9]{16}$"
        },
        "label": {
          "enum": [
            "Repeated setup or recovery workflow",
            "Repeated review or release workflow",
            "Repeated traceable delivery workflow",
            "Repeated correction rule",
            "Repeated tool sequence",
            "Recurring workflow"
          ]
        },
        "patternType": {
          "enum": [
            "repair-loop",
            "review-workflow",
            "delivery-workflow",
            "recurring-correction",
            "tool-sequence",
            "generic-workflow"
          ]
        },
        "classification": {
          "enum": [
            "root-cause-fix",
            "reuse-existing",
            "extend-existing",
            "consolidate-existing",
            "new-skill-candidate",
            "new-automation-candidate",
            "workflow-fix",
            "insufficient-evidence"
          ]
        },
        "confidence": {
          "enum": ["high", "medium", "low"]
        },
        "occurrences": {
          "type": "integer",
          "minimum": 2
        },
        "sessions": {
          "type": "integer",
          "minimum": 2
        },
        "activeDays": {
          "type": "integer",
          "minimum": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 2,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "evidenceId",
              "sourceId",
              "sessionAlias",
              "day",
              "recordOrdinals",
              "ruleId"
            ],
            "properties": {
              "evidenceId": {
                "type": "string",
                "pattern": "^evidence-[a-f0-9]{20}$"
              },
              "sourceId": {
                "$ref": "#/$defs/sourceBaseProperties/sourceId"
              },
              "sessionAlias": {
                "type": "string",
                "pattern": "^session-[0-9]{3,}$"
              },
              "day": {
                "type": "string",
                "format": "date"
              },
              "recordOrdinals": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "ruleId": {
                "type": "string",
                "pattern": "^detector\\.[a-z0-9.-]+\\.v1$"
              }
            }
          }
        },
        "observedActiveFriction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lowerSeconds", "upperSeconds", "method", "confidence"],
          "properties": {
            "lowerSeconds": {
              "type": "integer",
              "minimum": 0
            },
            "upperSeconds": {
              "type": "integer",
              "minimum": 0
            },
            "method": {
              "const": "capped-active-intervals-v1"
            },
            "confidence": {
              "enum": ["medium", "low", "unavailable"]
            }
          }
        },
        "existingCapability": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "match", "reason"],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "match": {
                  "enum": ["reuse", "extend", "possible-overlap"]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        },
        "capabilityMatches": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/capabilityMatch"
          }
        },
        "catalogCoverage": {
          "enum": ["none", "partial", "complete"]
        },
        "repositoryEvidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "events", "repositories", "pullRequests", "failedChecks"],
          "properties": {
            "status": {
              "enum": ["available", "unavailable"]
            },
            "events": {
              "type": "integer",
              "minimum": 0
            },
            "repositories": {
              "type": "integer",
              "minimum": 0
            },
            "pullRequests": {
              "type": "integer",
              "minimum": 0
            },
            "failedChecks": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "priorityBasisPoints": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "falsePositiveRisks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "status",
        "stage",
        "code",
        "acceptedRecords",
        "skippedRecords",
        "message"
      ],
      "properties": {
        "sourceId": {
          "$ref": "#/$defs/sourceBaseProperties/sourceId"
        },
        "status": {
          "enum": ["partial", "failed"]
        },
        "stage": {
          "enum": ["read", "parse", "normalize", "redact", "mine", "estate", "catalog", "activity"]
        },
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]+$"
        },
        "acceptedRecords": {
          "type": "integer",
          "minimum": 0
        },
        "skippedRecords": {
          "type": "integer",
          "minimum": 0
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "x-openrappter-contract": {
    "detectorVersion": "2",
    "maximumCandidates": 5,
    "maximumEvidencePerCandidate": 20,
    "minimumSessions": 3,
    "minimumActiveDays": 2,
    "activeGapCapSeconds": 300,
    "maximumInputBytes": 67108864,
    "maximumRecordsPerSource": 50000,
    "maximumTotalRecords": 100000,
    "maximumSkillDepth": 12,
    "maximumSkillDirectories": 2048,
    "maximumSkillEntries": 10000,
    "maximumSkillMetadataBytes": 67108864,
    "supportedInputs": [
      "claude-jsonl",
      "codex-jsonl",
      "copilot-export-jsonl",
      "openrappter-flight-json",
      "normalized-jsonl",
      "repository-activity-json-or-jsonl",
      "rapp-monorepo-manifest",
      "rapp-registry",
      "rapp-store",
      "rapp-skills-cat-catalog",
      "rar-match",
      "normalized-capabilities"
    ],
    "observeInvariants": [
      "explicit input paths only",
      "selected files are opened read-only without following symlinks",
      "every file, record, catalog, estate, evidence, and clustering operation is bounded",
      "exact duplicate sources are excluded before mining",
      "repository and estate evidence cannot satisfy session-demand thresholds",
      "no network calls",
      "no subprocess execution",
      "no repository, history, skill, hook, schedule, or automation mutation",
      "stdout is the only default output",
      "explicit output is POSIX-only, private, no-clobber, and outside every selected input scope",
      "raw prompts, tool arguments, outputs, paths, repository names, and identifiers never appear in reports",
      "transcript and repository content is inert data",
      "every partial, failed, duplicate, capped, or truncated source is reported",
      "promotion is outside this contract"
    ],
    "cli": {
      "command": "node scripts/rapter-clever-girl.mjs observe",
      "required": ["--input <path>"],
      "repeatable": [
        "--input <path>",
        "--activity <path>",
        "--skills-root <path>",
        "--capability-catalog <path>"
      ],
      "optional": [
        "--estate-manifest <path>",
        "--source auto|claude|codex|copilot|openrappter|normalized",
        "--since <ISO-8601>",
        "--until <ISO-8601>",
        "--min-sessions <integer>",
        "--min-days <integer>",
        "--output <new-explicit-POSIX-path>",
        "--pretty"
      ]
    }
  }
}
