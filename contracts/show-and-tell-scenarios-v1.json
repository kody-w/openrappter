{
  "schema": "openrappter-show-and-tell-scenarios/1.0",
  "purpose": "Deterministic Show-and-Tell evaluation scenarios. Both runtimes replay these synthetic events through the same pure functions - deterministic analysis, session bundling, and plan proposal - and must produce identical results. A scenario fails when a runtime drifts, not when a clock or a model changes.",
  "session": {
    "id": "scenario-session",
    "startedAt": 1700000000000,
    "maxDurationMs": 3600000,
    "pollIntervalMs": 2000
  },
  "scenarios": [
    {
      "id": "detour",
      "title": "A detour is segmented out instead of becoming a step",
      "intentHint": "Reconcile the quarterly expense sheet",
      "events": [
        {
          "type": "session.started",
          "source": "show-and-tell",
          "elapsedMs": 0,
          "data": {
            "captureMode": "context"
          }
        },
        {
          "type": "app.activate",
          "source": "context-collector",
          "elapsedMs": 1000,
          "data": {
            "app": "Numbers",
            "window": "Q3 expenses"
          }
        },
        {
          "type": "session.note",
          "source": "user-narration",
          "elapsedMs": 2000,
          "data": {
            "note": "I open the quarterly expense sheet and check the totals."
          }
        },
        {
          "type": "manual.observation",
          "source": "user-observation",
          "elapsedMs": 5000,
          "data": {
            "title": "Check the sheet total",
            "detail": "Confirmed the sheet total matches 1,240.50 USD.",
            "app": "Numbers"
          }
        },
        {
          "type": "app.activate",
          "source": "context-collector",
          "elapsedMs": 9000,
          "data": {
            "app": "Music",
            "window": "Now playing"
          }
        },
        {
          "type": "app.activate",
          "source": "context-collector",
          "elapsedMs": 12000,
          "data": {
            "app": "Numbers",
            "window": "Q3 expenses"
          }
        },
        {
          "type": "session.note",
          "source": "user-narration",
          "elapsedMs": 13000,
          "data": {
            "note": "Back in the sheet, I export the summary."
          }
        },
        {
          "type": "session.stopped",
          "source": "show-and-tell",
          "elapsedMs": 14000,
          "data": {}
        }
      ],
      "expect": {
        "analysisStepIds": [
          "s1",
          "s2",
          "s3",
          "s4"
        ],
        "bundle": {
          "meaningfulEventCount": 6,
          "segmentCount": 3,
          "narratedSegments": 2,
          "silentSegments": 1,
          "detourSegments": 1,
          "silentEvents": 1,
          "unexplainedFrames": 0,
          "longestGapMs": 4000,
          "explainedRatioMilli": 833,
          "segmentKinds": [
            "work",
            "detour",
            "work"
          ]
        },
        "plan": {
          "stepIds": [
            "s1",
            "s2",
            "s4"
          ],
          "valueIds": [
            "text_1",
            "amount_1"
          ],
          "stepDetails": {
            "s2": "Confirmed the sheet total matches {{amount_1}}."
          },
          "confirmationStepIds": [],
          "privacyKinds": [],
          "openQuestionSubstrings": [
            "were dropped because their only evidence was in a detour"
          ]
        }
      }
    },
