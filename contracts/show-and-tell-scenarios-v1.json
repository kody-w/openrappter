    {
      "id": "unexplained-capture",
      "title": "An unlabelled frame in a silent stretch is counted, not hidden",
      "intentHint": "Prepare the release checklist",
      "events": [
        {
          "type": "session.started",
          "source": "show-and-tell",
          "elapsedMs": 0,
          "data": {
            "captureMode": "context"
          }
        },
        {
          "type": "app.activate",
          "source": "context-collector",
          "elapsedMs": 1000,
          "data": {
            "app": "Terminal",
            "window": "release"
          }
        },
        {
          "type": "frame.captured",
          "source": "explicit-capture",
          "elapsedMs": 3000,
          "data": {
            "file": "frames/frame-1.png",
            "app": "Terminal",
            "window": "release"
