{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openrappter.dev/contracts/xpedition-extension-v1.json",
  "title": "XPedition Extension Descriptor v1",
  "description": "Public data-only descriptor for approved local application routes. Validation grants no capability or state access.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "safeDisplayText": {
      "type": "string",
      "description": "Printable display prose only: no URLs or private hosts, authorization material, secret-shaped values, or private service namespaces.",
      "pattern": "^(?![\\s\\S]*(?:https?|ftp|file):\\/\\/)(?![\\s\\S]*\\b(?:localhost|127(?:\\.\\d{1,3}){3}|10(?:\\.\\d{1,3}){3}|192\\.168(?:\\.\\d{1,3}){2}|172\\.(?:1[6-9]|2\\d|3[01])(?:\\.\\d{1,3}){2}|169\\.254(?:\\.\\d{1,3}){2}|\\[?::1\\]?|metadata\\.google\\.internal)\\b)(?![\\s\\S]*\\b(?:authorization|bearer|password|credential|api[ _-]?key|access[ _-]?token|client[ _-]?secret)\\b)(?![\\s\\S]*\\b(?:tenant|billing|admin|control[ _-]?plane|telemetry)\\b)(?![\\s\\S]*(?:ghp_|github_pat_|sk[-_][A-Za-z0-9]|xox[baprs]-|AKIA[A-Z0-9]{12}|eyJ[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}))[^\\u0000-\\u001F\\u007F]+$"
    }
  },
  "required": [
    "id",
    "title",
    "description",
    "glyph",
    "routeId",
    "requiredCapability",
    "surfaceVersion"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(?!.*(?:tenant|billing|admin|control-plane|telemetry))[a-z][a-z0-9-]{1,63}$"
    },
    "title": {
      "$ref": "#/$defs/safeDisplayText",
      "minLength": 1,
      "maxLength": 80
    },
    "description": {
      "$ref": "#/$defs/safeDisplayText",
      "minLength": 1,
      "maxLength": 240
    },
    "glyph": {
      "type": "string",
      "pattern": "^(?:[A-Z0-9]{1,3}|[+?@◇○▶↗]|···|>_|\\{ \\})$"
    },
    "routeId": {
      "type": "string",
      "enum": [
        "observe",
        "chat",
        "show-and-tell",
        "agents",
        "showcase",
        "flight",
        "skills",
        "channels",
        "sessions",
        "cron",
        "devices",
        "presence",
        "debug",
        "zen",
        "accounts",
        "memory",
        "settings",
        "terminal",
        "help"
      ]
    },
    "fragment": {
      "type": "string",
      "pattern": "^#(?!.*(?:tenant|billing|admin|control-plane|telemetry|token|secret|authorization))[a-z][a-z0-9-]{0,63}$"
    },
    "requiredCapability": {
      "type": "string",
      "enum": [
        "ui:view",
        "agent:read",
        "channel:read",
        "session:read",
        "skill:read",
        "system:read",
        "memory:read"
      ]
    },
    "surfaceVersion": {
      "const": 1
    }
  }
}
