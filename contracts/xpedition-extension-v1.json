{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openrappter.dev/contracts/xpedition-extension-v1.json",
  "title": "XPedition Extension Descriptor v1",
  "description": "Public data-only descriptor for approved local application routes. Validation grants no capability or state access.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "description",
    "glyph",
    "routeId",
    "requiredCapability",
    "surfaceVersion"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "glyph": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4
    },
    "routeId": {
      "type": "string",
      "enum": [
        "observe",
        "chat",
        "show-and-tell",
        "agents",
        "showcase",
        "flight",
        "skills",
        "channels",
        "sessions",
        "cron",
        "devices",
        "presence",
        "debug",
        "zen",
        "accounts",
        "memory",
        "settings",
        "terminal",
        "help"
      ]
    },
    "fragment": {
      "type": "string",
      "pattern": "^#[a-z][a-z0-9-]{0,63}$"
    },
    "requiredCapability": {
      "type": "string",
      "enum": [
        "ui:view",
        "agent:read",
        "channel:read",
        "session:read",
        "skill:read",
        "system:read",
        "memory:read"
      ]
    },
    "surfaceVersion": {
      "const": 1
    }
  }
}
