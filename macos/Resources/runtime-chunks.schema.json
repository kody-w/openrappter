{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openrappter-runtime-chunks/v1",
  "description": "A candidate-contained descriptor for runtime parts committed beside the candidate bundle. URLs are derived from that bundle's immutable directory, never supplied here. Ordered part sizes sum to the sealed archive size; every nonfinal part is exactly 33554432 bytes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "source_commit", "version", "architecture", "file", "sha256", "size", "parts"],
  "properties": {
    "schema": { "const": "openrappter-runtime-chunks/v1" },
    "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "architecture": { "enum": ["arm64", "x86_64"] },
    "file": { "type": "string", "pattern": "^openrappter-runtime-[0-9]+\\.[0-9]+\\.[0-9]+-darwin-(arm64|x86_64)\\.tar\\.gz$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "size": { "type": "integer", "minimum": 1, "maximum": 536870912 },
    "parts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "sha256", "size"],
        "properties": {
          "file": { "type": "string", "pattern": "^runtime-(arm64|x86_64)-[0-9]{4}-[0-9a-f]{64}\\.part$" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "size": { "type": "integer", "minimum": 1, "maximum": 33554432 }
        }
      }
    }
  }
}
