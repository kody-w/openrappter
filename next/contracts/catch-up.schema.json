{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rapp-work.catch-up/1",
  "title": "Read-only canonical Catch me up timeline",
  "type": "object",
  "readOnly": true,
  "additionalProperties": false,
  "required": ["schema", "root", "scope", "from", "to", "baseline", "steps", "next", "more", "selectionDigest", "digestSpace", "grades", "contract", "timelineDigest"],
  "properties": {
    "schema": { "const": "rapp-work.catch-up/1" },
    "root": { "type": "string" },
    "scope": { "type": "string" },
    "from": { "type": ["object", "null"] },
    "to": { "type": ["object", "null"] },
    "baseline": { "type": "object", "required": ["cursor", "grade", "stateDigest", "state", "reason", "sourceFrameHashes"] },
    "steps": {
      "type": "array", "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["cursor", "previousCursor", "event", "grade", "workGrade", "stateGrade", "sourceFrameHashes", "publicSummary", "stateDigest", "state", "reason", "guest", "guestDigest"],
        "properties": {
          "cursor": { "type": "object" },
          "previousCursor": { "type": ["object", "null"] },
          "event": { "type": "string" },
          "grade": { "enum": ["recorded", "reconstructed", "unavailable"] },
          "workGrade": { "enum": ["recorded", "unavailable"] },
          "stateGrade": { "enum": ["reconstructed", "unavailable"] },
          "sourceFrameHashes": { "type": "array", "items": { "$ref": "#/$defs/hash" } },
          "publicSummary": { "type": ["string", "null"] },
          "stateDigest": { "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] },
          "state": { "type": ["object", "null"] },
          "reason": { "type": ["string", "null"] },
          "guest": { "type": ["object", "null"] },
          "guestDigest": { "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] }
        }
      }
    },
    "next": { "type": ["object", "null"] },
    "more": { "type": "boolean" },
    "selectionDigest": { "$ref": "#/$defs/hash" },
    "digestSpace": { "const": "rapp/1:particle" },
    "grades": { "type": "object", "required": ["recorded", "reconstructed", "unavailable"] },
    "contract": { "type": "object" },
    "timelineDigest": { "$ref": "#/$defs/hash" }
  },
  "$defs": { "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" } },
  "$comment": "Cursors must match exact authorized canonical source occurrences. Recorded public/view intent is not a historical screen recording. Only the explicitly opted-in, independently approved canonical Omarchy guest lane can include recorded guest PNG bytes. Hashes do not grant authority."
}
